# Optional: increases the server-side GitHub API rate limit. Never expose this to the browser.
GITHUB_TOKEN=

# Required to unlock /admin. Keep both values server-only; do not prefix with NEXT_PUBLIC_.
# Use a strong passphrase of at least 16 characters.
ADMIN_PASSWORD=

# Random signing secret of at least 32 characters. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=
